        "model": "={{ ((($('Merge LLM config').first().json.llm_config) || []).filter(r => r.usage_key === 'qwen-assemble-ts.fallback' && r.active).sort((a, b) => a.rank - b.rank)[0] || {}).model || 'nvidia/nemotron-3-ultra-550b-a55b' }}",
