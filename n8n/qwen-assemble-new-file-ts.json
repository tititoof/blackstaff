      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var body = $input.first().json.body || {};\nvar wrapper = body.wrapper || {};\nreturn [{ json: {\n  project: body.project || '',\n  container: body.container || 'candlekeep-frontend-frontend-1',\n  targetFile: body.targetFile || '',\n  wrapper: { before: wrapper.before || '', after: wrapper.after || '' },\n  pieces: body.pieces || [],\n  systemPrompt: body.systemPrompt || 'You are a senior Vue 3 / Nuxt / TypeScript engineer working in this exact codebase (Pinia Options-API stores). Output ONLY the action method source, as a plain object-method (name(args) { ... } or async name(args) { ... }) - no function keyword, no arrow function, no surrounding actions/defineStore wrapper, no markdown fences, no explanation.'\n} }];"
      }
