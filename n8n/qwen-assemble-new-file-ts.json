    {
      "id": "0197b7c1-3a54-475b-8382-079b554db666",
      "name": "Assemble File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var config = $('Normalize Input').first().json;\nvar pieceMeta = $('Split Pieces').all();\nvar outputs = $input.all();\n\nfunction cleanPiece(raw) {\n  return (raw || '').replace(/^```[a-zA-Z]*\\n?/, '').replace(/```\\s*$/, '').trim();\n}\n\nvar results = pieceMeta.map(function(m, i) {\n  var piece = m.json.piece;\n  var raw = (outputs[i] && outputs[i].json && outputs[i].json.output) || '';\n  var cleaned = cleanPiece(raw);\n  var nameEscaped = piece.name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  var pattern = new RegExp('^(async\\\\s+)?' + nameEscaped + '\\\\s*\\\\(');\n  var valid = pattern.test(cleaned);\n  return {\n    name: piece.name,\n    order: piece.order != null ? piece.order : i,\n    prefix: piece.prefix || '',\n    body: cleaned,\n    valid: valid,\n    reason: valid ? null : (\"response did not start with '\" + piece.name + \"(' (or 'async \" + piece.name + \"(') after stripping markdown fences\")\n  };\n});\n\nvar invalid = results.filter(function(r) { return !r.valid; });\nif (invalid.length > 0) {\n  return [{ json: {\n    valid: false,\n    errors: invalid.map(function(r) { return r.name + ': ' + r.reason; }),\n    pieceResults: results\n  } }];\n}\n\nresults.sort(function(a, b) { return a.order - b.order; });\n\nfunction reindent(src, indent) {\n  return src.split('\\n').map(function(l) { return l.trim() === '' ? '' : indent + l; }).join('\\n');\n}\n\nvar indent = '    ';\nvar body = results.map(function(r) {\n  var prefixLine = r.prefix ? (indent + r.prefix.trim() + '\\n\\n') : '';\n  return prefixLine + reindent(r.body, indent) + ',';\n}).join('\\n\\n');\n\nvar content = config.wrapper.before + body + '\\n' + config.wrapper.after;\n\nreturn [{ json: {\n  valid: true,\n  content: content,\n  pieceResults: results,\n  targetFile: config.targetFile,\n  container: config.container\n} }];"
      }
    },
