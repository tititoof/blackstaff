        "jsCode": "var resp = $input.first().json;\nvar targetFile = $('Build Write Command').first().json.targetFile;\nvar content = $('Build Write Command').first().json.content;\nvar ok = resp.exitCode === 0;\nreturn [{ json: {\n  filesWritten: ok ? 1 : 0,\n  generatedFiles: ok ? [{ path: targetFile, content: content, language: 'typescript' }] : [],\n  error: ok ? null : (resp.stderr || resp.stdout || ('docker-bridge exec failed, exitCode ' + resp.exitCode)),\n  summary: ok ? ('1 fichier assemble et ecrit (' + targetFile + ')') : '0 fichier ecrit - echec syntaxe ou docker-bridge'\n} }];"
